---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Iconos.astro';
import { menuPrincipal } from '../lib/menu';
import { url, esExterno, fechaLarga, CATEGORIAS, idDe } from '../lib/util';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', (n) => !n.data.borrador);
  const paginas = await getCollection('paginas');
  return [
    ...noticias.map((e) => ({ params: { slug: e.id }, props: { tipo: 'noticia' as const, entrada: e } })),
    ...paginas.map((e) => ({ params: { slug: e.id }, props: { tipo: 'pagina' as const, entrada: e } })),
  ];
}

const { tipo, entrada } = Astro.props;
const { Content } = await render(entrada);
const data = entrada.data as any;
// Una página puede reunir otras (ej. «Reglamentos y protocolos»): se muestran como secciones, con un índice arriba.
const secciones = tipo === 'pagina' && data.reune?.length
  ? (await Promise.all((data.reune as string[]).map(async (ref) => {
      const e = idDe(ref) ? await getEntry('paginas', idDe(ref)) : undefined;
      return e ? { id: e.id, titulo: e.data.titulo, vacia: !e.body?.trim(), Content: (await render(e)).Content } : null;
    }))).filter((x) => x !== null)
  : [];
const vacia = !entrada.body?.trim() && secciones.length === 0;
const ruta = `/${entrada.id}/`;
// Sección del menú a la que pertenece la página (para las migas y las subpáginas).
const menu = await menuPrincipal();
const seccion = menu.find((i) => i.enlace === ruta);
const padre = menu.find((i) => i.submenu?.some((s) => s.enlace === ruta) && i.enlace !== ruta);
const subpaginas = seccion?.submenu ?? [];
const migas = tipo === 'noticia'
  ? [{ texto: CATEGORIAS[data.categoria], enlace: `/category/${data.categoria}/` }]
  : padre ? [{ texto: padre.texto, enlace: padre.enlace }] : [];
const resumen = data.resumen || `${data.titulo} – Colegio Marina de Chile`;
---
<Base titulo={data.titulo} descripcion={resumen} imagen={data.imagen}>
  <CabeceraPagina titulo={data.titulo} migas={migas}>
    {tipo === 'noticia' && (
      <p class="meta meta-clara">
        <span class={`etiqueta cat-${data.categoria}`}>{CATEGORIAS[data.categoria]}</span>
        <time datetime={data.fecha.toISOString().slice(0, 10)}>{fechaLarga(data.fecha)}</time>
      </p>
    )}
  </CabeceraPagina>
  <div class="contenedor contenido-centrado">
    <article class={`entrada pagina-${entrada.id}`}>
      {tipo === 'noticia' && data.imagen && !entrada.body?.includes(data.imagen) && (
        <img class="entrada-imagen" src={url(data.imagen)} alt="" />
      )}

      {data.documento && (
        <div class="documento">
          <object data={url(data.documento)} type="application/pdf" aria-label={data.titulo}></object>
          <p class="parrafo-boton"><a class="boton" href={url(data.documento)} target="_blank" rel="noopener"><Icono nombre="pdf" tamano={18} /> Descargar {data.titulo} (PDF)</a></p>
        </div>
      )}

      <div class="contenido">
        <Content />
        {secciones.length > 0 && (
          <>
            <nav class="indice-secciones" aria-label="En esta página">
              {secciones.map((s) => <a href={`#${s.id}`}>{s.titulo}</a>)}
            </nav>
            {secciones.map((s) => (
              <section class="seccion-reunida" id={s.id}>
                <h2>{s.titulo}</h2>
                {s.vacia
                  ? <p class="aviso">Estamos actualizando este documento. Pronto estará disponible aquí.</p>
                  : <s.Content />}
              </section>
            ))}
          </>
        )}
        {vacia && !data.documento && subpaginas.length > 0 && (
          <ul class="subpaginas">
            {subpaginas.map((s) => (
              <li><a href={url(s.enlace)} {...(esExterno(s.enlace) ? { target: '_blank', rel: 'noopener' } : {})}>
                {s.texto} <Icono nombre={esExterno(s.enlace) ? 'enlace' : 'flecha'} tamano={18} />
              </a></li>
            ))}
          </ul>
        )}
        {vacia && !data.documento && subpaginas.length === 0 && (
          <p class="aviso">Estamos actualizando esta sección. Pronto encontrarás aquí más información.</p>
        )}
      </div>
    </article>
  </div>
</Base>
