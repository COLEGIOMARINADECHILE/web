---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import CabeceraPagina from '../../../components/CabeceraPagina.astro';
import ListaNoticias from '../../../components/ListaNoticias.astro';
import Paginacion from '../../../components/Paginacion.astro';
import { noticiasOrdenadas, POR_PAGINA, CATEGORIAS, url } from '../../../lib/util';

export const getStaticPaths = (async ({ paginate }) => {
  const rutas = [];
  for (const categoria of Object.keys(CATEGORIAS)) {
    rutas.push(...paginate(await noticiasOrdenadas(categoria), { pageSize: POR_PAGINA, params: { categoria } }));
  }
  return rutas;
}) satisfies GetStaticPaths;
const { page } = Astro.props;
const { categoria } = Astro.params;
const nombre = CATEGORIAS[categoria];
---
<Base titulo={nombre}>
  <CabeceraPagina titulo={nombre} migas={[{ texto: 'Noticias', enlace: '/noticias/' }]}>
    <ul class="filtros">
      <li><a href={url('/noticias/')}>Todas</a></li>
      {Object.entries(CATEGORIAS).map(([c, n]) => <li><a href={url(`/category/${c}/`)} aria-current={c === categoria ? 'page' : undefined}>{n}</a></li>)}
    </ul>
  </CabeceraPagina>
  <section class="contenedor seccion-interior">
    <ListaNoticias noticias={page.data} />
    <Paginacion page={page} raiz={url(`/category/${categoria}/`)} />
  </section>
</Base>
