---
import Base from '../layouts/Base.astro';
import Icono from '../components/Iconos.astro';
import portada from '../data/portada.json';
import { getEntry } from 'astro:content';
import { url, idDe, esExterno, numeroCircular, temaCircular } from '../lib/util';

// Todo lo de la portada se elige en Pages CMS, en «Portada» (src/data/portada.json).
type Ref = { tipo?: string; pagina?: string | null; noticia?: string | null };

// Carrusel: páginas y noticias en el orden elegido.
const destacadas = (await Promise.all((portada.carrusel as Ref[]).map(async (r) => {
  const e = r.tipo === 'noticia'
    ? (idDe(r.noticia) ? await getEntry('noticias', idDe(r.noticia)) : undefined)
    : (idDe(r.pagina) ? await getEntry('paginas', idDe(r.pagina)) : undefined);
  return e ? { id: e.id, data: e.data, sobretitulo: e.collection === 'paginas' ? 'Nuestro colegio' : 'Destacado' } : null;
}))).filter((d): d is NonNullable<typeof d> => d !== null);

// Tarjetas bajo el carrusel (hasta 5): cada una puede ser la próxima actividad, una noticia o
// circular, una página o un enlace (a otra página del sitio o a otro sitio web).
// El título y la imagen se pueden cambiar en cada tarjeta.
type TarjetaCMS = Ref & { titulo?: string | null; enlace?: string | null; imagen?: string | null };
type Acceso = { titulo: string; imagen?: string | null; enlace: string; etiqueta: string; circular?: string; externo?: boolean };
const evento = portada.proximaActividad;
const resolver = async (t: TarjetaCMS): Promise<Acceso | null> => {
  let base: Acceso | null = null;
  if (t.tipo === 'evento') {
    base = { titulo: evento.titulo, imagen: evento.imagen, enlace: evento.enlace || '/', etiqueta: 'Próxima actividad' };
  } else if (t.tipo === 'noticia') {
    const e = idDe(t.noticia) ? await getEntry('noticias', idDe(t.noticia)) : undefined;
    if (e) {
      const esCircular = e.data.categoria === 'circulares';
      const numero = esCircular ? numeroCircular(e.data.titulo) : undefined;
      base = {
        titulo: esCircular ? temaCircular(e.data.titulo) : e.data.titulo, imagen: e.data.imagen, enlace: `/${e.id}/`,
        etiqueta: esCircular ? (numero ? `Circular N°${numero}` : 'Circular') : 'Noticia', circular: esCircular ? (numero ?? '') : undefined,
      };
    }
  } else if (t.tipo === 'pagina') {
    const e = idDe(t.pagina) ? await getEntry('paginas', idDe(t.pagina)) : undefined;
    if (e) base = { titulo: e.data.titulo, imagen: e.data.imagen, enlace: `/${e.id}/`, etiqueta: 'Nuestro colegio' };
  } else if (t.tipo === 'enlace' && t.enlace) {
    base = { titulo: t.titulo || t.enlace, enlace: t.enlace, etiqueta: esExterno(t.enlace) ? 'Enlace externo' : 'Destacado', externo: esExterno(t.enlace) };
  }
  if (!base) return null;
  return { ...base, titulo: t.titulo || base.titulo, imagen: t.imagen || base.imagen };
};
const accesos = (await Promise.all(((portada as { tarjetas: TarjetaCMS[] }).tarjetas ?? []).slice(0, 5).map(resolver)))
  .filter((a): a is Acceso => a !== null);
---
<Base portada>
  {destacadas.length > 0 && (
    <section class="portada" aria-label="Destacados" aria-roledescription="carrusel">
      <div class="contenedor">
        <div class="carrusel">
          <div class="carrusel-pista">
            {destacadas.map((n, i) => (
              <article class="diapositiva" aria-label={`${i + 1} de ${destacadas.length}`}>
                <a class="diapositiva-imagen" href={url(`/${n.id}/`)} tabindex="-1" aria-hidden="true">
                  {n.data.imagen && <img src={url(n.data.imagen)} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />}
                </a>
                <div class="diapositiva-texto">
                  <span class="sobretitulo">{n.sobretitulo}</span>
                  <h2><a href={url(`/${n.id}/`)}>{n.data.titulo}</a></h2>
                  {n.data.resumen && <p>{n.data.resumen}</p>}
                  <a class="boton boton-amarillo" href={url(`/${n.id}/`)}>Seguir leyendo <Icono nombre="flecha" tamano={18} /></a>
                </div>
              </article>
            ))}
          </div>
          {destacadas.length > 1 && (
            <>
              <button class="carrusel-flecha carrusel-anterior" type="button" aria-label="Destacado anterior"><Icono nombre="flecha" tamano={22} /></button>
              <button class="carrusel-flecha carrusel-siguiente" type="button" aria-label="Destacado siguiente"><Icono nombre="flecha" tamano={22} /></button>
              <div class="carrusel-puntos">
                {destacadas.map((_, i) => <button type="button" aria-label={`Ver destacado ${i + 1}`} data-i={i} aria-current={i === 0 ? 'true' : undefined}></button>)}
              </div>
            </>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="contenedor accesos" aria-label="Accesos rápidos" style={`--accesos: ${accesos.length}`}>
    {accesos.map((a) => (
      <a class="acceso" href={url(a.enlace)} {...(a.externo ? { target: '_blank', rel: 'noopener' } : {})}>
        {a.imagen
          ? <img src={url(a.imagen)} alt="" loading="lazy" decoding="async" width="400" height="225" />
          : a.circular !== undefined
            ? <span class="acceso-circular" aria-hidden="true"><small>Circular</small>{a.circular && <b><small>N°</small>{a.circular}</b>}</span>
            : <span class="acceso-sin-imagen"><Icono nombre={a.externo ? 'enlace' : 'noticia'} tamano={36} /></span>}
        <span class="acceso-texto"><small>{a.etiqueta}</small>{a.titulo} <Icono nombre={a.externo ? 'enlace' : 'flecha'} tamano={18} /></span>
      </a>
    ))}
  </section>
</Base>

<script>
  // Carrusel: avanza solo cada 7 segundos; también con flechas y puntos.
  const pista = document.querySelector<HTMLElement>('.carrusel-pista');
  const puntos = [...document.querySelectorAll<HTMLButtonElement>('.carrusel-puntos button')];
  if (pista && puntos.length > 1) {
    let actual = 0;
    const marcar = (i: number) => puntos.forEach((p, j) => p.toggleAttribute('aria-current', j === i));
    const ir = (i: number) => {
      actual = (i + puntos.length) % puntos.length;
      pista.scrollTo({ left: pista.clientWidth * actual, behavior: 'smooth' });
      marcar(actual);
    };
    const detener = () => clearInterval(t);
    puntos.forEach((p, i) => p.addEventListener('click', () => { ir(i); detener(); }));
    document.querySelector('.carrusel-anterior')?.addEventListener('click', () => { ir(actual - 1); detener(); });
    document.querySelector('.carrusel-siguiente')?.addEventListener('click', () => { ir(actual + 1); detener(); });
    pista.addEventListener('scroll', () => { actual = Math.round(pista.scrollLeft / pista.clientWidth); marcar(actual); }, { passive: true });
    const t = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : setInterval(() => ir(actual + 1), 7000);
    pista.addEventListener('pointerenter', detener);
  }
</script>
