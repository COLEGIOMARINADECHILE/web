---
import Base from '../layouts/Base.astro';
import Lateral from '../components/Lateral.astro';
import ListaNoticias from '../components/ListaNoticias.astro';
import sitio from '../data/sitio.json';
import { actividades } from '../data/actividades.json';
import { url, esExterno, noticiasOrdenadas, POR_PAGINA } from '../lib/util';

const noticias = await noticiasOrdenadas();
const destacadas = noticias.filter((n) => n.data.destacada);
const recientes = noticias.slice(0, POR_PAGINA);
const hayMas = noticias.length > POR_PAGINA;

const dias = new Intl.DateTimeFormat('es-CL', { weekday: 'long', timeZone: 'UTC' });
const meses = new Intl.DateTimeFormat('es-CL', { month: 'long', timeZone: 'UTC' });
const agenda = [...actividades]
  .sort((a, b) => a.fecha.localeCompare(b.fecha))
  .map((a) => {
    const d = new Date(a.fecha + 'T00:00:00Z');
    return { ...a, dia: d.getUTCDate(), mes: meses.format(d), semana: dias.format(d) };
  });
const idPost = (enlace: string) => enlace.match(/instagram\.com\/(?:p|reel)\/([^/?#]+)/)?.[1];
---
<Base>
  {destacadas.length > 0 && (
    <section class="carrusel" aria-label="Destacados" aria-roledescription="carrusel">
      <div class="carrusel-pista">
        {destacadas.map((n, i) => (
          <article class="diapositiva" id={`diapositiva-${i}`} aria-label={`${i + 1} de ${destacadas.length}`}>
            {n.data.imagen && <img src={url(n.data.imagen)} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />}
            <div class="diapositiva-texto">
              <h2><a href={url(`/${n.id}/`)}>{n.data.titulo}</a></h2>
              {n.data.resumen && <p>{n.data.resumen} […]</p>}
              <a class="boton" href={url(`/${n.id}/`)}>Seguir leyendo</a>
            </div>
          </article>
        ))}
      </div>
      {destacadas.length > 1 && (
        <div class="carrusel-puntos">
          {destacadas.map((_, i) => <button type="button" aria-label={`Ver destacado ${i + 1}`} data-i={i} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
      )}
    </section>
  )}

  <section class="destacados">
    {sitio.destacados.map((d) => (
      <a class="destacado" href={url(d.enlace)} {...(esExterno(d.enlace) ? { target: '_blank', rel: 'noopener' } : {})}>
        <img src={url(d.imagen)} alt="" loading="lazy" decoding="async" width="320" height="180" />
        <span>{d.titulo}</span>
      </a>
    ))}
  </section>

  <hr class="separador" />

  <div class="dos-columnas">
    <section>
      <h2 class="barra-titulo">Últimas Actividades</h2>
      <div class="instagram-cabecera">
        <a href={`https://www.instagram.com/${sitio.instagram.usuario}/`} target="_blank" rel="noopener"><strong>{sitio.instagram.usuario}</strong></a>
        <p>{sitio.instagram.descripcion}</p>
      </div>
      <div class="instagram-grilla">
        {sitio.instagram.publicaciones.map((p) => idPost(p) && (
          <iframe src={`https://www.instagram.com/p/${idPost(p)}/embed`} title="Publicación de Instagram" loading="lazy"></iframe>
        ))}
      </div>
      <p class="centrado"><a class="boton boton-instagram" href={`https://www.instagram.com/${sitio.instagram.usuario}/`} target="_blank" rel="noopener">Seguir en Instagram</a></p>
    </section>

    <section>
      <h2 class="barra-titulo">Próximas Actividades</h2>
      <ol class="agenda">
        {agenda.map((a) => (
          <li data-fecha={a.fecha}>
            <div class="agenda-fecha"><span class="agenda-dia">{a.dia}</span><span class="agenda-mes">{a.mes}<br /><b>{a.semana}</b></span></div>
            <p>{a.titulo}</p>
          </li>
        ))}
      </ol>
      <p class="agenda-vacia" hidden>No hay actividades programadas por ahora. Revisa nuestras redes sociales para estar al día.</p>
    </section>
  </div>

  <hr class="separador" />

  <div class="con-lateral">
    <section>
      <ListaNoticias noticias={recientes} titulo="Noticias recientes" />
      {hayMas && <nav class="paginacion"><span aria-current="page">1</span><a href={url('/noticias/2/')}>2</a><a href={url('/noticias/2/')}>Siguientes</a></nav>}
    </section>
    <Lateral />
  </div>
</Base>

<script>
  // Agenda: oculta actividades cuya fecha ya pasó.
  const hoy = new Date().toISOString().slice(0, 10);
  const items = document.querySelectorAll<HTMLElement>('.agenda li');
  let visibles = 0;
  items.forEach((li) => { const pasada = (li.dataset.fecha ?? '') < hoy; li.hidden = pasada; if (!pasada) visibles++; });
  if (!visibles) document.querySelector<HTMLElement>('.agenda-vacia')?.removeAttribute('hidden');

  // Carrusel: avanza solo cada 7 segundos y con los puntos.
  const pista = document.querySelector<HTMLElement>('.carrusel-pista');
  const puntos = [...document.querySelectorAll<HTMLButtonElement>('.carrusel-puntos button')];
  if (pista && puntos.length > 1) {
    let actual = 0;
    const ir = (i: number) => {
      actual = (i + puntos.length) % puntos.length;
      pista.scrollTo({ left: pista.clientWidth * actual, behavior: 'smooth' });
      puntos.forEach((p, j) => p.toggleAttribute('aria-current', j === actual));
    };
    puntos.forEach((p, i) => p.addEventListener('click', () => { ir(i); clearInterval(t); }));
    pista.addEventListener('scroll', () => {
      const i = Math.round(pista.scrollLeft / pista.clientWidth);
      puntos.forEach((p, j) => p.toggleAttribute('aria-current', j === i));
      actual = i;
    }, { passive: true });
    const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const t = reducir ? 0 : setInterval(() => ir(actual + 1), 7000);
  }
</script>
