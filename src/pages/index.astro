---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Iconos.astro';
import sitio from '../data/sitio.json';
import { url, esExterno, noticiasOrdenadas } from '../lib/util';

const destacadas = (await noticiasOrdenadas()).filter((n) => n.data.destacada);
const ext = (e: string) => (esExterno(e) ? { target: '_blank', rel: 'noopener' } : {});
---
<Base>
  <CabeceraPagina titulo={sitio.nombre} inicio>
    <p class="cabecera-lema">{sitio.lema}</p>
  </CabeceraPagina>

  {destacadas.length > 0 && (
    <section class="portada" aria-label="Destacados" aria-roledescription="carrusel">
      <div class="contenedor">
        <div class="carrusel-pista">
          {destacadas.map((n, i) => (
            <article class="diapositiva" aria-label={`${i + 1} de ${destacadas.length}`}>
              <div class="diapositiva-texto">
                <span class="sobretitulo">Destacado</span>
                <h2><a href={url(`/${n.id}/`)}>{n.data.titulo}</a></h2>
                {n.data.resumen && <p>{n.data.resumen}</p>}
                <a class="boton boton-amarillo" href={url(`/${n.id}/`)}>Seguir leyendo <Icono nombre="flecha" tamano={18} /></a>
              </div>
              <a class="diapositiva-imagen" href={url(`/${n.id}/`)} tabindex="-1" aria-hidden="true">
                {n.data.imagen && <img src={url(n.data.imagen)} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />}
              </a>
            </article>
          ))}
        </div>
        {destacadas.length > 1 && (
          <div class="carrusel-puntos">
            {destacadas.map((_, i) => <button type="button" aria-label={`Ver destacado ${i + 1}`} data-i={i} aria-current={i === 0 ? 'true' : undefined}></button>)}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="contenedor accesos" aria-label="Accesos rápidos">
    {sitio.destacados.map((d) => (
      <a class="acceso" href={url(d.enlace)} {...ext(d.enlace)}>
        <img src={url(d.imagen)} alt="" loading="lazy" decoding="async" width="400" height="225" />
        <span class="acceso-texto">{d.titulo} <Icono nombre={esExterno(d.enlace) ? 'enlace' : 'flecha'} tamano={18} /></span>
      </a>
    ))}
  </section>
</Base>

<script>
  // Carrusel: avanza solo cada 7 segundos y con los puntos.
  const pista = document.querySelector<HTMLElement>('.carrusel-pista');
  const puntos = [...document.querySelectorAll<HTMLButtonElement>('.carrusel-puntos button')];
  if (pista && puntos.length > 1) {
    let actual = 0;
    const marcar = (i: number) => puntos.forEach((p, j) => p.toggleAttribute('aria-current', j === i));
    const ir = (i: number) => {
      actual = (i + puntos.length) % puntos.length;
      pista.scrollTo({ left: pista.clientWidth * actual, behavior: 'smooth' });
      marcar(actual);
    };
    puntos.forEach((p, i) => p.addEventListener('click', () => { ir(i); clearInterval(t); }));
    pista.addEventListener('scroll', () => { actual = Math.round(pista.scrollLeft / pista.clientWidth); marcar(actual); }, { passive: true });
    const t = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : setInterval(() => ir(actual + 1), 7000);
    pista.addEventListener('pointerenter', () => clearInterval(t));
  }
</script>
