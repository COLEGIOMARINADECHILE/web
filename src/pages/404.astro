---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import { url } from '../lib/util';
---
<Base titulo="Página no encontrada">
  <CabeceraPagina titulo="Página no encontrada" />
  <section class="contenedor seccion-interior">
    <p>La página que buscas no existe o cambió de dirección.</p>
    <p class="parrafo-boton"><a class="boton" href={url('/')}>Volver al inicio</a></p>
  </section>
</Base>
