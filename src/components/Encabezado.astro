---
import menu from '../data/menu.json';
import sitio from '../data/sitio.json';
import Icono from './Iconos.astro';
import { url, esExterno } from '../lib/util';
const actual = Astro.url.pathname;
const activo = (e: string) => !esExterno(e) && actual === url(e);
const seccionActiva = (item: (typeof menu.items)[number]) => activo(item.enlace) || item.submenu?.some((s) => activo(s.enlace));
const ext = (e: string) => (esExterno(e) ? { target: '_blank', rel: 'noopener' } : {});
const instagram = sitio.redes.find((r) => /instagram/i.test(r.url))?.url;
const youtube = sitio.redes.find((r) => /youtube/i.test(r.url))?.url;
// La última opción del menú (Admisión) se destaca como botón.
const principales = menu.items.slice(0, -1);
const llamado = menu.items.at(-1);
---
<div class="barra-superior">
  <div class="contenedor">
    <span><Icono nombre="ubicacion" tamano={15} /> {sitio.direccion}, {sitio.comuna}, {sitio.ciudad}</span>
    <a href={`tel:${sitio.telefono.replace(/\s/g, '')}`}><Icono nombre="telefono" tamano={15} /> {sitio.telefono}</a>
    <span class="barra-redes">
      {instagram && <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icono nombre="instagram" tamano={16} /></a>}
      {youtube && <a href={youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icono nombre="youtube" tamano={17} /></a>}
    </span>
  </div>
</div>
<header class="cabecera">
  <div class="contenedor cabecera-fila">
    <a class="logo" href={url('/')}>
      <img src={url('/uploads/2025/01/cropped-logo-240x100-1.png')} alt={sitio.nombre} width="240" height="100" />
    </a>
    <button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu-lista" aria-label="Abrir menú">
      <span class="menu-icono" aria-hidden="true"></span>
    </button>
    <nav class="menu" aria-label="Menú principal">
      <ul id="menu-lista" class="menu-lista">
        {principales.map((item) => (
          <li class:list={['menu-item', { 'tiene-sub': item.submenu?.length, activo: seccionActiva(item) }]}>
            <a href={url(item.enlace)} aria-current={activo(item.enlace) ? 'page' : undefined} {...ext(item.enlace)}>{item.texto}</a>
            {item.submenu?.length > 0 && (
              <>
                <button class="sub-boton" type="button" aria-expanded="false" aria-label={`Abrir ${item.texto}`}></button>
                <ul class="submenu">
                  {item.submenu.map((s) => (
                    <li><a href={url(s.enlace)} aria-current={activo(s.enlace) ? 'page' : undefined} {...ext(s.enlace)}>{s.texto}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
        {llamado && <li class="menu-item menu-llamado"><a href={url(llamado.enlace)} {...ext(llamado.enlace)}>{llamado.texto}</a></li>}
      </ul>
    </nav>
  </div>
</header>
<script>
  const boton = document.querySelector<HTMLButtonElement>('.menu-boton');
  const lista = document.getElementById('menu-lista');
  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    boton.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    lista?.classList.toggle('abierto', !abierto);
  });
  document.querySelectorAll<HTMLButtonElement>('.sub-boton').forEach((b) =>
    b.addEventListener('click', () => {
      const abierto = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!abierto));
      b.parentElement?.classList.toggle('sub-abierto', !abierto);
    })
  );
  const cabecera = document.querySelector('.cabecera');
  addEventListener('scroll', () => cabecera?.classList.toggle('con-sombra', scrollY > 40), { passive: true });
</script>
