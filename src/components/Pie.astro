---
import sitio from '../data/sitio.json';
import Icono from './Iconos.astro';
import { url, esExterno } from '../lib/util';
import { enlacesPie } from '../lib/menu';
const informacion = await enlacesPie(sitio.pieInformacion);
const interes = await enlacesPie(sitio.pieEnlaces);
const anio = new Date().getFullYear();
const ext = (e: string) => (esExterno(e) ? { target: '_blank', rel: 'noopener' } : {});
---
<footer class="pie">
  <div class="contenedor pie-columnas">
    <section class="pie-marca">
      <img src={url('/uploads/2026/11/escudo-70-circular.png')} alt="Insignia de los 70 años del Colegio Marina de Chile" width="96" height="96" loading="lazy" />
      <div>
        <p class="pie-nombre">{sitio.nombre}</p>
        <p class="pie-lema">{sitio.lema}</p>
        <address>
          <span><Icono nombre="ubicacion" tamano={16} /> {sitio.direccion}, {sitio.comuna}, {sitio.ciudad}</span>
          <a href={`tel:${sitio.telefono.replace(/\s/g, '')}`}><Icono nombre="telefono" tamano={16} /> {sitio.telefono}</a>
        </address>
      </div>
    </section>
    <section>
      <h2>Información</h2>
      <ul>{informacion.map((l) => <li><a href={url(l.enlace)} {...ext(l.enlace)}>{l.texto}</a></li>)}</ul>
    </section>
    <section>
      <h2>Enlaces de interés</h2>
      <ul>{interes.map((l) => <li><a href={url(l.enlace)} {...ext(l.enlace)}>{l.texto}</a></li>)}</ul>
    </section>
    <section>
      <h2>Síguenos</h2>
      <ul>{sitio.redes.slice(0, 4).map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}</ul>
    </section>
  </div>
  <div class="contenedor pie-final">
    <p>© {anio} {sitio.nombre} · {sitio.ciudad}<a class="pie-cms" href="https://app.pagescms.org/COLEGIOMARINADECHILE/web/main" target="_blank" rel="nofollow noopener" aria-label="Editar el sitio (Pages CMS)" title="Editar el sitio">✎</a></p>
  </div>
</footer>
