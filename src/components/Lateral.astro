---
import sitio from '../data/sitio.json';
import Icono from './Iconos.astro';
import { url, fechaLarga, noticiasOrdenadas } from '../lib/util';
const circulares = (await noticiasOrdenadas('circulares')).slice(0, 4);
---
<aside class="lateral">
  <section class="tarjeta-lateral">
    <h2>Circulares</h2>
    <ul class="lista-circulares">
      {circulares.map((c) => (
        <li><a href={url(`/${c.id}/`)}><Icono nombre="pdf" /><span>{c.data.titulo}<small>{fechaLarga(c.data.fecha)}</small></span></a></li>
      ))}
    </ul>
    <a class="enlace-flecha" href={url('/category/circulares/')}>Ver todas <Icono nombre="flecha" tamano={16} /></a>
  </section>
  <section class="tarjeta-lateral">
    <h2>Redes sociales</h2>
    <ul class="chips">
      {sitio.redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}
    </ul>
  </section>
</aside>
