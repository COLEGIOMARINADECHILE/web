---
import { url, fechaLarga, CATEGORIAS, type Noticia } from '../lib/util';
interface Props { noticias: Noticia[]; titulo?: string }
const { noticias, titulo } = Astro.props;
---
{titulo && <h2 class="barra-titulo">{titulo}</h2>}
<div class="lista-noticias">
  {noticias.map((n) => (
    <article class:list={['tarjeta-noticia', { 'sin-imagen': !n.data.imagen }]}>
      {n.data.imagen && (
        <a class="tarjeta-imagen" href={url(`/${n.id}/`)} tabindex="-1" aria-hidden="true">
          <img src={url(n.data.imagen)} alt="" loading="lazy" decoding="async" width="200" height="125" />
        </a>
      )}
      <div class="tarjeta-texto">
        <h3><a href={url(`/${n.id}/`)}>{n.data.titulo}</a></h3>
        {n.data.resumen && <p>{n.data.resumen}{n.data.resumen.endsWith('.') ? '' : ' […]'}</p>}
        <p class="meta">
          <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{fechaLarga(n.data.fecha)}</time>
          <a href={url(`/category/${n.data.categoria}/`)}>{CATEGORIAS[n.data.categoria]}</a>
        </p>
      </div>
    </article>
  ))}
</div>
