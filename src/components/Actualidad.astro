---
// Bloque de actualidad al final de las páginas.
// Portada: próxima actividad, agenda semanal y circulares; abajo las 3 últimas actividades
// (noticias y publicaciones de Instagram mezcladas por fecha).
// Demás páginas: agenda semanal, la última actividad y redes sociales.
import sitio from '../data/sitio.json';
import datosPortada from '../data/portada.json';
const { actividades } = datosPortada;
import Icono from './Iconos.astro';
import TarjetaNoticia from './TarjetaNoticia.astro';
import { url, esExterno, fechaLarga, noticiasOrdenadas, type Noticia } from '../lib/util';

interface Props { portada?: boolean }
const { portada = false } = Astro.props;

const noticias = await noticiasOrdenadas();
// Circulares: número (de «Circular N°18/2026: …») y tema sin el prefijo, para mostrarlas como la agenda.
const circulares = noticias.filter((n) => n.data.categoria === 'circulares').slice(0, 4).map((c) => {
  const numero = c.data.titulo.match(/n\s*[°º.]?\s*(\d+)/i)?.[1];
  const tema = c.data.titulo.replace(/^circular\s*n\s*[°º.]?\s*\d+(\s*\/\s*\d{4})?\s*[:\-–]?\s*/i, '').trim();
  return { id: c.id, fecha: c.data.fecha, numero, tema: tema || c.data.titulo };
});

const dias = new Intl.DateTimeFormat('es-CL', { weekday: 'long', timeZone: 'UTC' });
const meses = new Intl.DateTimeFormat('es-CL', { month: 'short', timeZone: 'UTC' });
const fechaEvento = new Intl.DateTimeFormat('es-CL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const agenda = [...actividades]
  .sort((a, b) => a.fecha.localeCompare(b.fecha))
  .map((a) => {
    const d = new Date(a.fecha + 'T00:00:00Z');
    return { ...a, dia: d.getUTCDate(), mes: meses.format(d).replace('.', ''), semana: dias.format(d) };
  });

const evento = datosPortada.proximaActividad as { titulo: string; fecha?: string; hora?: string; lugar?: string; descripcion?: string; imagen?: string; enlace?: string };
const eventoFecha = evento.fecha ? fechaEvento.format(new Date(evento.fecha + 'T00:00:00Z')) : 'Fecha por confirmar';

// La fecha de una publicación de Instagram viene dentro de su código (los primeros bits del ID son la hora).
const ALFABETO = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
const fechaInstagram = (codigo: string) => {
  let id = 0n;
  for (const c of codigo) id = id * 64n + BigInt(ALFABETO.indexOf(c));
  return new Date(Number((id >> 23n) + 1314220021721n));
};
type Item = { tipo: 'noticia'; fecha: Date; noticia: Noticia } | { tipo: 'instagram'; fecha: Date; codigo: string };
const publicaciones: Item[] = datosPortada.instagram
  .map((p) => p.match(/instagram\.com\/(?:p|reel)\/([^/?#]+)/)?.[1])
  .filter((c): c is string => !!c)
  .map((codigo) => ({ tipo: 'instagram', fecha: fechaInstagram(codigo), codigo }));
const recientes: Item[] = noticias
  .filter((n) => n.data.categoria !== 'circulares')
  .map((noticia) => ({ tipo: 'noticia', fecha: noticia.data.fecha, noticia }));
const ultimas = [...publicaciones, ...recientes].sort((a, b) => b.fecha.getTime() - a.fecha.getTime()).slice(0, 3);
const ext = (e: string) => (esExterno(e) ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="seccion seccion-suave actualidad">
  <div class="contenedor tres-bloques">
    {portada && <section class="bloque">
      <h2 class="bloque-titulo">Próxima actividad</h2>
      <div class="evento-marco">
        {evento.imagen && <img class="evento-imagen" src={url(evento.imagen)} alt="" loading="lazy" decoding="async" width="600" height="338" />}
        <h3>{evento.titulo}</h3>
        <p class="evento-dato"><Icono nombre="calendario" tamano={17} /> <span class="evento-fecha">{eventoFecha}{evento.hora && ` · ${evento.hora}`}</span></p>
        {evento.lugar && <p class="evento-dato"><Icono nombre="ubicacion" tamano={17} /> {evento.lugar}</p>}
        {evento.descripcion && <p class="evento-texto">{evento.descripcion}</p>}
      </div>
      {evento.enlace && <a class="enlace-flecha bloque-pie" href={url(evento.enlace)} {...ext(evento.enlace)}>Más información <Icono nombre="flecha" tamano={16} /></a>}
    </section>}

    <section class="bloque">
      <h2 class="bloque-titulo">Esta semana</h2>
      <ol class="agenda">
        {agenda.map((a) => (
          <li data-fecha={a.fecha}>
            <span class="agenda-fecha"><b>{a.dia}</b>{a.mes}</span>
            <span class="agenda-texto"><small>{a.semana}</small>{a.titulo}</span>
          </li>
        ))}
      </ol>
      <p class="agenda-vacia" hidden><Icono nombre="calendario" tamano={28} /> No hay actividades programadas esta semana. Revisa nuestras redes sociales para estar al día.</p>
    </section>

    {portada ? <section class="bloque">
      <div class="bloque-cabecera">
        <h2 class="bloque-titulo">Circulares</h2>
        <a class="enlace-flecha" href={url('/category/circulares/')}>Ver todas <Icono nombre="flecha" tamano={16} /></a>
      </div>
      <ul class="agenda circulares-lista">
        {circulares.map((c) => (
          <li><a href={url(`/${c.id}/`)}>
            <span class="circular-hoja" aria-hidden="true">{c.numero ? <><small>N°</small><b>{c.numero}</b></> : <Icono nombre="pdf" tamano={22} />}</span>
            <span class="agenda-texto"><small>{fechaLarga(c.fecha)}</small>{c.numero && <span class="visualmente-oculto">Circular N°{c.numero}: </span>}{c.tema}</span>
          </a></li>
        ))}
      </ul>
    </section> : <>
      <section class="bloque bloque-ultima">
        <h2 class="bloque-titulo">Última actividad</h2>
        {ultimas[0] && (ultimas[0].tipo === 'noticia'
          ? <TarjetaNoticia noticia={ultimas[0].noticia} />
          : <div class="tarjeta-instagram"><iframe src={`https://www.instagram.com/p/${ultimas[0].codigo}/embed`} title="Publicación de Instagram" loading="lazy" scrolling="no"></iframe></div>)}
        <a class="enlace-flecha bloque-pie" href={url('/noticias/')}>Todas las noticias <Icono nombre="flecha" tamano={16} /></a>
      </section>
      <section class="bloque">
        <h2 class="bloque-titulo">Redes sociales</h2>
        <ul class="chips">
          {sitio.redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}
        </ul>
      </section>
    </>}
  </div>

  {portada && <div class="contenedor ultimas">
    <header class="seccion-cabecera ultimas-cabecera">
      <div class="ultimas-titulo">
        <h2 class="titulo-seccion">Últimas actividades</h2>
        <span class="seccion-bajada">Noticias y publicaciones</span>
      </div>
      <div class="ultimas-acciones">
        <a class="boton boton-contorno" href={url('/noticias/')}><Icono nombre="noticia" tamano={18} /> Todas las noticias</a>
        <a class="boton boton-contorno" href={`https://www.instagram.com/${sitio.instagram.usuario}/`} target="_blank" rel="noopener"><Icono nombre="instagram" tamano={18} /> Seguir en Instagram</a>
      </div>
    </header>
    <div class="tres-bloques grilla-ultimas">
      {ultimas.map((i) => <div class="bloque bloque-post">{i.tipo === 'noticia'
        ? <TarjetaNoticia noticia={i.noticia} />
        : <div class="tarjeta-instagram"><iframe src={`https://www.instagram.com/p/${i.codigo}/embed`} title="Publicación de Instagram" loading="lazy" scrolling="no"></iframe></div>}</div>)}
    </div>
  </div>}
</section>

<script>
  // Agenda: oculta lo que ya pasó y muestra solo las 4 próximas actividades.
  const hoy = new Date().toISOString().slice(0, 10);
  let visibles = 0;
  document.querySelectorAll<HTMLElement>('.agenda:not(.circulares-lista) li').forEach((li) => {
    const mostrar = (li.dataset.fecha ?? '') >= hoy && visibles < 4;
    li.hidden = !mostrar;
    if (mostrar) visibles++;
  });
  if (!visibles) document.querySelector<HTMLElement>('.agenda-vacia')?.removeAttribute('hidden');

  // Portada: las publicaciones de «Últimas actividades» toman el mismo alto que la fila de arriba.
  // Se mide el último bloque (Circulares), que siempre ocupa una sola fila.
  const bloqueArriba = document.querySelector<HTMLElement>('.actualidad .tres-bloques:not(.grilla-ultimas) > .bloque:last-child');
  const filaUltimas = document.querySelector<HTMLElement>('.grilla-ultimas');
  if (bloqueArriba && filaUltimas) {
    const igualar = () => filaUltimas.style.setProperty('--alto-fila', `${bloqueArriba.getBoundingClientRect().height}px`);
    igualar();
    new ResizeObserver(igualar).observe(bloqueArriba);
  }
</script>
